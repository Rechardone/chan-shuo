# Database
CHAN_SHUO_DB=data/market-core.db

# Local Ollama models, recommended for low-cost daily use.
# Examples: gemma3:4b, deepseek-r1:7b, qwen2.5:7b
USE_OLLAMA=0
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud / API models.
# Prefer cheaper OpenAI-compatible providers such as DeepSeek or Qwen-compatible endpoints.
# Do not commit real keys.
USE_CLOUD_LLM=0
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Other examples:
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
