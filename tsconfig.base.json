{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@chan-shuo/core": ["packages/core/src/index.ts"],
      "@chan-shuo/db": ["packages/db/src/index.ts"],
      "@chan-shuo/llm": ["packages/llm/src/index.ts"],
      "@chan-shuo/sources": ["packages/sources/src/index.ts"]
    }
  }
}
