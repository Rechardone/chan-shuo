{
  "name": "chan-shuo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "tsx packages/db/src/init.ts",
    "agent:mock": "pnpm --filter @chan-shuo/agent mock",
    "ai:review": "pnpm --filter @chan-shuo/agent review",
    "ai:plan": "pnpm --filter @chan-shuo/agent plan",
    "ai:news": "pnpm --filter @chan-shuo/agent news",
    "ai:theme": "pnpm --filter @chan-shuo/agent theme",
    "llm:test": "pnpm --filter @chan-shuo/agent llm:test",
    "desktop:dev": "pnpm --filter @chan-shuo/desktop dev",
    "desktop:build": "pnpm --filter @chan-shuo/desktop build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
